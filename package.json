{
  "name": "emudevz",
  "version": "1.0.0",
  "description": "Mobile-first NES emulator with advanced features",
  "main": "src/index.jsx",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node src/test/test.js",
    "test:mobile": "node -e \"require('./src/utils/mobileTesting.js').default.runCompatibilityTests()\"",
    "deploy": "npm run build && vercel --prod",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint src --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "analyze": "npm run build && npx vite-bundle-analyzer build/stats.html",
    "package": "node scripts/package-levels.js",
    "sort-locales": "node scripts/sort-locales.js",
    "sort-dictionary": "node scripts/sort-dictionary.js"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.0",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/language": "^6.11.3",
    "@codemirror/lint": "^6.9.1",
    "@codemirror/state": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.38.6",
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "^5.14.19",
    "@mui/lab": "^5.0.0-alpha.153",
    "@mui/material": "^5.18.0",
    "@rematch/core": "^2.2.0",
    "@rematch/loading": "^2.1.2",
    "@rematch/persist": "^2.1.2",
    "@uiw/react-codemirror": "^4.25.2",
    "bootstrap": "^5.3.2",
    "broken-neees": "^1.0.77",
    "browserfs": "^1.4.3",
    "chai": "^6.2.0",
    "classnames": "^2.3.2",
    "cli-highlight": "^2.1.11",
    "connected-react-router": "^6.9.3",
    "escape-string-regexp": "^5.0.0",
    "eslint-linter-browserify": "^9.38.0",
    "eventemitter3": "^5.0.1",
    "globals": "^16.4.0",
    "grapheme-splitter": "^1.0.4",
    "highlight.js": "^11.9.0",
    "history": "^5.3.0",
    "javascript-time-ago": "^2.5.9",
    "jszip": "^3.10.1",
    "lodash": "^4.17.21",
    "marked": "^16.4.1",
    "marked-highlight": "^2.2.2",
    "nes-emu": "^1.0.53",
    "path-browserify-esm": "^1.0.0",
    "pixi-filters": "^6.0.4",
    "pixi.js": "^8.14.0",
    "prop-types": "^15.8.1",
    "react": "^17.0.2",
    "react-beautiful-dnd": "^13.1.1",
    "react-bootstrap": "^2.9.2",
    "react-diff-viewer-continued": "^3.2.6",
    "react-dom": "^17.0.2",
    "react-fast-marquee": "^1.6.2",
    "react-hot-toast": "^2.4.1",
    "react-icons": "^4.12.0",
    "react-image-diff": "^0.1.0",
    "react-redux": "^7.2.9",
    "react-router-dom": "^5.3.4",
    "redux-persist": "^6.0.0",
    "ringbufferjs": "^2.0.0",
    "updated-xterm-for-react": "^5.5.1",
    "web-vitals": "^3.5.0",
    "xterm": "~5.2.0",
    "xterm-addon-fit": "^0.8.0",
    "xterm-addon-image": "^0.4.0",
    "yaml": "^2.3.4"
  },
  "devDependencies": {
    "@types/react": "^17.0.71",
    "@types/react-dom": "^17.0.25",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^8.57.0",
    "eslint-config-react-app": "^7.0.1",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "prettier": "^3.2.5",
    "sinon": "^21.0.0",
    "sinon-chai": "^4.0.1",
    "vite": "^6.3.5",
    "vite-bundle-analyzer": "^0.7.0",
    "workbox-build": "^7.0.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version",
      "last 1 ios version",
      "last 1 android version"
    ]
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "keywords": [
    "emulator",
    "nes",
    "mobile",
    "pwa",
    "webgl",
    "touch",
    "gestures",
    "performance"
