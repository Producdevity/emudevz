{
  "name": "emudevz",
  "version": "1.0.0",
  "description": "Mobile-first NES emulator with advanced features",
  "main": "src/index.jsx",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node src/test/test.js",
    "test:mobile": "node -e \"require('./src/utils/mobileTesting.js').default.runCompatibilityTests()\"",
    "deploy": "npm run build && vercel --prod",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint src --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "analyze": "npm run build && npx vite-bundle-analyzer build/stats.html",
    "package": "node scripts/package-levels.js",
    "sort-locales": "node scripts/sort-locales.js",
    "sort-dictionary": "node scripts/sort-dictionary.js"
  },
  "dependencies": {
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "^5.14.19",
    "@mui/material": "^5.14.20",
    "@mui/lab": "^5.0.0-alpha.153",
    "@rematch/core": "^2.2.0",
    "@rematch/loading": "^2.1.2",
    "@rematch/persist": "^2.1.2",
    "bootstrap": "^5.3.2",
    "browserfs": "^1.4.3",
    "classnames": "^2.3.2",
    "lodash": "^4.17.21",
    "pixi.js": "^7.4.2",
    "@pixi/layers": "^2.1.0",
    "pixi-filters": "^6.0.4",
    "pixi-lights": "^3.0.0",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-hot-toast": "^2.4.1",
    "react-redux": "^7.2.9",
    "react-router-dom": "^5.3.4",
    "connected-react-router": "^6.9.3",
    "highlight.js": "^11.9.0",
    "jszip": "^3.10.1",
    "xterm": "~5.2.0",
    "xterm-addon-fit": "^0.8.0",
    "xterm-addon-image": "^0.4.0",
    "web-vitals": "^3.5.0"
  },
  "devDependencies": {
    "@types/react": "^17.0.71",
    "@types/react-dom": "^17.0.25",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^8.57.0",
    "eslint-config-react-app": "^7.0.1",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "prettier": "^3.2.5",
    "vite": "^6.3.5",
    "vite-bundle-analyzer": "^0.7.0",
    "workbox-build": "^7.0.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version",
      "last 1 ios version",
      "last 1 android version"
    ]
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "keywords": [
    "emulator",
    "nes",
    "mobile",
    "pwa",
    "webgl",
    "touch",
    "gestures",
    "performance"
  ],
  "author": "Emudevz Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/emudevz/emudevz.git"
  },
  "bugs": {
    "url": "https://github.com/emudevz/emudevz/issues"
  },
  "homepage": "https://emudevz.com",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/emudevz"
  }
}