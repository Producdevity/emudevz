{
	"version": 2,
	"buildCommand": "npm run build",
	"outputDirectory": "build",
	"installCommand": "npm install --legacy-peer-deps",

	"headers": [
		{
			"source": "/(.*)",
			"headers": [
				{
					"key": "X-Content-Type-Options",
					"value": "nosniff"
				},
				{
					"key": "X-Frame-Options",
					"value": "DENY"
				},
				{
					"key": "X-XSS-Protection",
					"value": "1; mode=block"
				},
				{
					"key": "Referrer-Policy",
					"value": "strict-origin-when-cross-origin"
				}
			]
		},
		{
			"source": "/static/(.*)",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=31536000, immutable"
				}
			]
		}
	],
	"env": {
		"NODE_ENV": "production"
	},

	"rewrites": [
		{
			"source": "/api/(.*)",
			"destination": "/api/$1"
		}
	],
	"trailingSlash": false,
	"cleanUrls": true
}
